# Server Configuration
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-app.vercel.app

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_echits_production_2026_!
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL for Cloud Testing)
# Example for Neon.tech / Supabase / Render / Railway:
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/echits?sslmode=require

# Or individual Postgres parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=echits
DB_SSL=true

# SQLite fallback (For local development only)
SQLITE_PATH=echits.db
